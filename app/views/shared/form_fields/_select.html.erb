<div <%= tag.attributes(class: wrapper_class, style: wrapper_style, data: wrapper_data) %>>
  <fieldset class="<%= mode == :model ? 'fieldset w-full resource-form-fieldset' : 'fieldset w-full search-form-fieldset' %>">
    <label class="label" for="<%= field_id %>">
      <span class="label-text"><%= label_text %></span>
    </label>
    <select
      id="<%= field_id %>"
      name="<%= input_name %><%= '[]' if mode == :model && (field[:multi] || field[:multiple]) %>"
      class="select select-bordered w-full <%= mode == :model ? "resource-form-control#{' resource-form-control--error' if has_error}" : 'search-form-control' %>"
      style="<%= control_style %>"
      <%= 'required' if mode == :model && field[:required] %>
      <%= 'disabled' if mode == :model && (field[:disabled] || field[:readonly]) %>
      <%= 'multiple' if mode == :model && (field[:multi] || field[:multiple]) %>
      <%= tag.attributes(data: input_data) if mode == :model %>>
      <% normalized_options.each do |option| %>
        <option value="<%= option[:value] %>" <%= 'selected' if option[:selected] %>><%= option[:label] %></option>
      <% end %>
    </select>
    <% if error_text.present? %>
      <p class="label"><span class="label-text-alt text-error"><%= error_text %></span></p>
    <% elsif help_text.present? %>
      <p class="label"><span class="label-text-alt"><%= help_text %></span></p>
    <% end %>
  </fieldset>
</div>
