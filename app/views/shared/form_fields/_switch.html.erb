<div <%= tag.attributes(class: wrapper_class, style: wrapper_style, data: wrapper_data) %>>
  <fieldset class="<%= mode == :model ? 'fieldset w-full resource-form-fieldset' : 'fieldset w-full search-form-fieldset' %>">
    <label class="label" for="<%= field_id %>">
      <span class="label-text"><%= label_text %></span>
    </label>
    <label class="<%= mode == :model ? 'resource-form-switch label cursor-pointer justify-start gap-3 rounded-xl border px-3 py-2.5' : 'search-form-switch label cursor-pointer justify-start gap-3 rounded-xl border px-3 py-2.5' %>">
      <input id="<%= field_id %>" name="<%= input_name %>" value="Y" type="checkbox" class="toggle toggle-success toggle-sm" <%= 'checked' if checked %> <%= tag.attributes(data: input_data) if mode == :model %>>
      <span class="label-text"><%= label_text %></span>
    </label>
    <% if error_text.present? %>
      <p class="label"><span class="label-text-alt text-error"><%= error_text %></span></p>
    <% elsif help_text.present? %>
      <p class="label"><span class="label-text-alt"><%= help_text %></span></p>
    <% end %>
  </fieldset>
</div>
